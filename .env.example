# Contact form delivery (Resend).
# Without RESEND_API_KEY the server action logs the enquiry instead of sending,
# so local development works with no credentials.

# From the Resend dashboard, API Keys. Starts with "re_".
RESEND_API_KEY=

# Optional overrides. Every address must be on a domain verified in Resend.
# The defaults come from site.contactEmail in src/lib/content.ts:
#   CONTACT_TO          where enquiries go          hello@chukwuebukaonyemelukwe.com
#   CONTACT_FROM        sender of the sender's copy  Chukwuebuka Onyemelukwe <hello@…>
#   CONTACT_NOTIFY_FROM sender of the enquiry        Website enquiries <enquiries@…>
# CONTACT_TO=
# CONTACT_FROM=
# CONTACT_NOTIFY_FROM=
