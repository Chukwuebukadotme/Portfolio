# Contact form delivery (Resend).
# Without RESEND_API_KEY the server action logs the enquiry instead of sending,
# so local development works with no credentials.

# From the Resend dashboard, API Keys. Starts with "re_".
RESEND_API_KEY=

# Must be an address on a domain you have verified in Resend.
CONTACT_FROM="Chukwuebuka Onyemelukwe <hello@chukwuebukaonyemelukwe.com>"

# Where enquiries land. Defaults to site.email in src/lib/content.ts.
CONTACT_TO=chukwuebukaspad@gmail.com
